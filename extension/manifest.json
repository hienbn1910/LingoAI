{
  "manifest_version": 3,
  "name": "LingoAI Local",
  "version": "1.0.0",
  "minimum_chrome_version": "124",
  "description": "Dịch phần bôi đen và hỏi AI qua backend LingoAI local.",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Mở LingoAI"
  }
}